# =============================================================================
# Canva Docs Graphify - Environment Variables
# =============================================================================
# Copy this file to .env and set ONE of the API keys below.
# Then run: python _run_graphify.py
#
# Detection priority (auto): gemini → kimi → claude → openai → deepseek → ollama
# Override via: GRAPHIFY_BACKEND=openai
# =============================================================================

# ── Gemini (Google) ──────────────────────────────────────────────────────────
# Default model: gemini-2.5-flash
# Get key: https://ai.google.dev/
# GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted as fallback
#
# Multiple keys can be space or comma separated for automatic rotation
# when rate-limited (429):
#   GOOGLE_API_KEY = "key1 key2 key3"

# ── Kimi (Moonshot) ─────────────────────────────────────────────────────────
# Default model: kimi-k2.6
# MOONSHOT_API_KEY=

# ── Claude (Anthropic) ──────────────────────────────────────────────────────
# Default model: claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Default model: gpt-4.1-mini
# OPENAI_API_KEY=

# ── DeepSeek ────────────────────────────────────────────────────────────────
# Default model: deepseek-v4-flash
# DEEPSEEK_API_KEY=

# ── Custom OpenAI-compatible backends ───────────────────────────────────────
# Set OPENAI_API_KEY + OPENAI_BASE_URL to use any OpenAI-compatible provider.
# Popular free/cheap options:
#
#   Genfity (free tier models):
#     OPENAI_BASE_URL=https://ai.genfity.com/v1
#     OPENAI_API_KEY=genfity_e...
#
#   iyh.app (cheap Gemini/Claude models):
#     OPENAI_BASE_URL=https://v1.iyhapi.app
#     OPENAI_API_KEY=iyh_...
#
#   NVIDIA NIM (free tier, 40 req/min, 1000 credits):
#     OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#     OPENAI_API_KEY=nvapi-...
#     GRAPHIFY_MODEL=meta/llama-3.1-70b-instruct
#     Sign up: https://build.nvidia.com/

# ── Ollama (Local) ──────────────────────────────────────────────────────────
# For fully local extraction (no API key needed for localhost):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_API_KEY=ollama

# ── AWS Bedrock ─────────────────────────────────────────────────────────────
# Uses boto3; region + profile or default credential chain
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default

# ── Claude CLI (Local) ──────────────────────────────────────────────────────
# Routes through locally-installed `claude` CLI (Claude Code).
# No API key needed — uses your existing Pro/Max subscription.

# ── Graphify Overrides ──────────────────────────────────────────────────────
# Force a specific backend (overrides auto-detection):
# GRAPHIFY_BACKEND=openai
# Override the default model for the detected backend:
# GRAPHIFY_MODEL=gemini-3-flash

# ── Performance Tuning ──────────────────────────────────────────────────────
# GRAPHIFY_MAX_OUTPUT_TOKENS=16384
# GRAPHIFY_API_TIMEOUT=600
